# Thin overlay: slimerl/slime base + our fork of slime + llm4cov_oss submodule.
#
# Use this instead of docker/Dockerfile when you only need the agentic_cov
# additions on top of an already-published slimerl/slime image. ~5 min build,
# <100 MB of new layer content vs the ~54 GB monolithic build.
#
# slimerl/slime:v0.2.4 already ships the same package set we need
# (transformers 4.57.1, sglang 0.5.9, openai 2.6.1, pydantic 2.12.5, datasets
# 4.5.0, flash-attn 2.7.4 + flash-attn-3, apex, TE 2.10, megatron-core,
# sgl-router, all megatron sibling dirs). The only runtime additions for
# llm4cov are tree-sitter + tree-sitter-systemverilog.

ARG BASE_IMAGE_TAG=v0.2.4
FROM slimerl/slime:${BASE_IMAGE_TAG}

ARG SLIME_REPO_URL=https://github.com/HejiaZ2023/slime.git
ARG SLIME_COMMIT=main

# Replace upstream THUDM/slime checkout with our fork.
#
# The code is already present in the build context: a fresh brev launch clones
# brev_docker (which now vendors the complete ctr_slime/slime + full llm4cov_oss),
# and `make build` uses that local dir as the build context. So we COPY it in
# rather than re-fetching.
#
# The old git-clone path is DISABLED on purpose: it pulled the gutted
# HejiaZ2023/llm4cov_oss (no xfer_client.py / sftp, no local-parquet loader) and
# its pinned submodule commit (6ea9e0c) was deleted upstream, so
# `git submodule update --init` failed and broke the build.
# ARG SLIME_REPO_URL / SLIME_COMMIT above are now unused.
# RUN rm -rf /root/slime && \
#     git clone --recurse-submodules ${SLIME_REPO_URL} /root/slime && \
#     cd /root/slime && \
#     git checkout ${SLIME_COMMIT} && \
#     git submodule update --init --recursive && \
#     pip install --no-deps --no-build-isolation -e .
RUN rm -rf /root/slime
COPY . /root/slime

# Patch the base-image SGLang to support OPD teacher forced scoring with
# per-position requested token ids. This keeps teacher scoring responses at
# [response_chunk_len, topk] instead of [response_chunk_len, union(topk)].
RUN cd /sgl-workspace/sglang && \
    git apply -p1 /root/slime/docker/patch/llm4cov/opd_topk_token_ids_sglang.patch

# Integrity check: fail the build early if the vendored llm4cov_oss is the gutted
# version (missing the sftp transport / local-parquet loader) instead of the
# complete one — exactly the files the old submodule path used to drop.
RUN test -f /root/slime/third_party/llm4cov_oss/src/llm4cov/eda_client/xfer_client.py \
 && test -f /root/slime/third_party/llm4cov_oss/src/llm4cov/datasets/load.py \
 && test -f /root/slime/examples/agentic_cov/reward.py \
 || { echo "ERROR: vendored slime/llm4cov_oss is INCOMPLETE — re-vendor from brev_docker"; exit 1; }

RUN cd /root/slime && pip install --no-deps --no-build-isolation -e .

# int4_qat extension is built against the slime source tree, so rebuild
# against our fork's copy (kernel sources are identical to upstream today,
# but this keeps the binary in sync if either side changes).
RUN cd /root/slime/slime/backends/megatron_utils/kernels/int4_qat && \
    pip install . --no-build-isolation

# llm4cov_oss editable install; --no-deps preserves the carefully pinned
# Megatron / TE / transformers / etc. from the base image. tree-sitter is the
# only runtime dep not already satisfied.
RUN pip install paramiko && \
    pip install --no-deps -e /root/slime/third_party/llm4cov_oss && \
    pip install 'tree-sitter>=0.25.2' 'tree-sitter-systemverilog>=0.3.1' && \
    python -c 'from llm4cov.datasets.load import load_dataset_by_name; print("llm4cov import OK")'

# SSH bootstrap entrypoint: copies a host SSH dir bind-mounted at
# /run/host-ssh into /root/.ssh on container start (no-op if not mounted),
# so the rollout's llm4cov.eda_client.remote_* can reach the EDA host via
# its SSH alias. See examples/agentic_cov/container_launch/ for the
# matching Makefile that wires the mounts.
COPY examples/agentic_cov/container_launch/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod 755 /usr/local/bin/docker-entrypoint.sh

WORKDIR /root/slime
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["/bin/bash"]

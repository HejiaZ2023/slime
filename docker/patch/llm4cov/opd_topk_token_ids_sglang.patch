+def get_requested_token_ids_logprobs_chunk(
+    logprobs: torch.Tensor,
+    token_ids_logprobs: List[int],
+    topk_token_ids_logprobs: Optional[List[Optional[List[List[int]]]]],
+    pruned_lens: List[int],
+    input_token_ids_logprobs_val: List,
+    input_token_ids_logprobs_idx: List,
+    split_pruned_len: int = 0,
+):
+    """Get request-level or per-position requested token id logprobs for a chunk."""
+    if not topk_token_ids_logprobs or not any(
+        token_rows is not None for token_rows in topk_token_ids_logprobs
+    ):
+        return get_token_ids_logprobs_chunk(
+            logprobs,
+            token_ids_logprobs,
+            pruned_lens,
+            input_token_ids_logprobs_val,
+            input_token_ids_logprobs_idx,
+            split_pruned_len,
+        )
+
+    if logprobs.shape[0] == 0:
+        return 0
+
+    token_ids_logprobs = token_ids_logprobs or [None] * len(pruned_lens)
+    pt = 0
+    next_split_pruned_len = 0
+    for n, (token_ids, token_rows, pruned_len) in enumerate(
+        zip(token_ids_logprobs, topk_token_ids_logprobs, pruned_lens)
+    ):
+        row_offset = split_pruned_len if n == 0 else 0
+        remaining_len = pruned_len - row_offset
+        if n != 0:
+            split_pruned_len = 0
+
+        if remaining_len <= 0:
+            input_token_ids_logprobs_val.append([])
+            input_token_ids_logprobs_idx.append([])
+            continue
+
+        val = []
+        idx = []
+        for j in range(remaining_len):
+            if pt + j >= logprobs.shape[0]:
+                next_split_pruned_len = row_offset + j
+                break
+            row_idx = row_offset + j
+            if token_rows is None:
+                row_token_ids = token_ids or []
+            else:
+                row_token_ids = token_rows[row_idx] if row_idx < len(token_rows) else []
+            val.append(logprobs[pt + j, row_token_ids].tolist())
+            idx.append(row_token_ids)
+
+        if len(val) > 0:
+            if row_offset > 0:
+                input_token_ids_logprobs_val[-1].extend(val)
+                input_token_ids_logprobs_idx[-1].extend(idx)
+            else:
+                input_token_ids_logprobs_val.append(val)
+                input_token_ids_logprobs_idx.append(idx)
+
+        pt += remaining_len
+    return next_split_pruned_len
+
+
